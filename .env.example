# BYOP configuration. Copy to .env (`cp .env.example .env`) and adjust.
# `make up` fills in BYOP_SECRET_KEY automatically when it is empty.
# Never commit your real .env.

# --- Core ---------------------------------------------------------------
# Signs session cookies and encrypts stored provider credentials (Fernet).
# Generate one with: openssl rand -hex 32
BYOP_SECRET_KEY=
# How long a login session stays valid, in hours.
BYOP_SESSION_HOURS=168
# The single admin account, created on first start (the password is hashed into the
# database; later changes go through the app, not through this file).
BYOP_ADMIN_EMAIL=admin@example.com
BYOP_ADMIN_PASSWORD=change-me-now
# Externally reachable base URL, used to build RSS feed and audio links.
PUBLIC_BASE_URL=http://localhost:8080
# Host port the web UI is published on.
BYOP_WEB_PORT=8080
# Logging verbosity: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# --- Infrastructure -----------------------------------------------------
# Hostnames below are the docker compose service names.
DATABASE_URL=postgresql+asyncpg://byop:byop@postgres:5432/byop
REDIS_URL=redis://redis:6379/0
# Used by the postgres container; keep in sync with DATABASE_URL.
POSTGRES_USER=byop
POSTGRES_PASSWORD=byop
POSTGRES_DB=byop
# Dev-only host ports (loopback) for postgres and redis, used by `make test`.
BYOP_POSTGRES_PORT=5432
BYOP_REDIS_PORT=6379
# Where the api tests find Postgres from the host; the database is created on demand.
# TEST_DATABASE_URL=postgresql+asyncpg://byop:byop@localhost:5432/byop_test

# --- Provider keys (optional; can also be set in Settings > Integrations) -
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Local Kokoro text-to-speech. Leave empty to use the bundled service
# (`make up-kokoro` / `docker compose --profile kokoro up -d`, http://kokoro:8880/v1),
# or point it at your own Kokoro-FastAPI / OpenAI-compatible speech server.
KOKORO_BASE_URL=

# --- Sources ----------------------------------------------------------------
# Feeds and pages are fetched from URLs users type in. Only public internet addresses are
# allowed unless this is true (for a feed on your own network, e.g. a self-hosted RSS bridge).
# Link-local/metadata addresses are always refused.
SOURCES_ALLOW_PRIVATE_NETWORKS=false

# --- Ingest (collecting stories before an episode) --------------------------
INGEST_FRESHNESS_DAYS=3
INGEST_DEDUP_DAYS=14
# Trigram similarity (0-1) at which two headlines count as the same story.
INGEST_TITLE_SIMILARITY=0.55
INGEST_SOURCE_TIMEOUT_S=30

# --- Source discovery (optional) -------------------------------------------
# The model that searches the web for sources. Empty: the show's model, then the default below.
# On OpenRouter ":online" is added to the model id so it can search. Provider is
# openrouter | openai | openai_compatible.
DISCOVERY_LLM_PROVIDER=
DISCOVERY_LLM_MODEL=

# --- Defaults for new shows (optional) ----------------------------------
# Applied when a show is created without its own choice. Provider is one of
# openrouter | openai | openai_compatible; style is news_briefing | conversational |
# deep_dive | interview. Leave the model empty to choose per show.
DEFAULT_LLM_PROVIDER=
DEFAULT_LLM_MODEL=
DEFAULT_SHOW_STYLE=news_briefing

# --- Media storage (covers, audio) ---------------------------------------
# local: files on the media volume (default). s3: any S3-compatible service (AWS S3, MinIO,
# RustFS, ...). With the bundled service (`make up-minio`) use:
#   STORAGE_BACKEND=s3  S3_ENDPOINT_URL=http://s3:9000  S3_BUCKET=byop
#   and S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY of your choice (the service uses the same values).
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
# Only if links for browsers must use another address than S3_ENDPOINT_URL.
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Langfuse tracing (optional) ----------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
