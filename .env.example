# BYOP configuration. Copy to .env (`cp .env.example .env`) and adjust.
# `make up` fills in BYOP_SECRET_KEY automatically when it is empty.
# Never commit your real .env.

# --- Core ---------------------------------------------------------------
# Signs session cookies and encrypts stored provider credentials (Fernet).
# Generate one with: openssl rand -hex 32
BYOP_SECRET_KEY=
# How long a login session stays valid, in hours.
BYOP_SESSION_HOURS=168
# The single admin account, created on first start (the password is hashed into the
# database; later changes go through the app, not through this file).
BYOP_ADMIN_EMAIL=admin@example.com
BYOP_ADMIN_PASSWORD=change-me-now
# Externally reachable base URL (no trailing slash needed). It builds the absolute addresses in
# the public RSS feed (feed, audio, cover); podcast apps need it to be public https.
PUBLIC_BASE_URL=http://localhost:8080
# Host port the web UI is published on.
BYOP_WEB_PORT=8080
# Run a published release instead of building from source: set a version (for example 0.1.0),
# then `docker compose -f docker-compose.yml pull && docker compose -f docker-compose.yml up -d`.
# Leave empty to build the images from this checkout. See docs/releasing.md.
BYOP_VERSION=
# Logging verbosity: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# --- Infrastructure -----------------------------------------------------
# Hostnames below are the docker compose service names.
DATABASE_URL=postgresql+asyncpg://byop:byop@postgres:5432/byop
REDIS_URL=redis://redis:6379/0
# Used by the postgres container; keep in sync with DATABASE_URL.
POSTGRES_USER=byop
POSTGRES_PASSWORD=byop
POSTGRES_DB=byop
# Dev-only host ports (loopback) for postgres and redis, used by `make test`.
BYOP_POSTGRES_PORT=5432
BYOP_REDIS_PORT=6379
# Where the api tests find Postgres from the host; the database is created on demand.
# TEST_DATABASE_URL=postgresql+asyncpg://byop:byop@localhost:5432/byop_test

# --- Provider keys (optional; can also be set in Settings > Integrations) -
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Local Kokoro text-to-speech. Leave empty: `make up-full` (or `make up-kokoro`) points the app at the
# bundled service (http://kokoro:8880/v1) and a minimal `make up` has no Kokoro. Set it to use your own
# Kokoro-FastAPI / OpenAI-compatible speech server, or http://kokoro:8880/v1 with plain
# `docker compose --profile kokoro up -d`.
KOKORO_BASE_URL=

# --- Public routes --------------------------------------------------------
# Requests per minute and client address to the public podcast feed and to episode audio (a
# player that seeks makes several requests for one episode). 0 switches a limit off. Login has its
# own fixed limit of 5 attempts a minute.
PUBLIC_FEED_RATE_PER_MINUTE=120
PUBLIC_MEDIA_RATE_PER_MINUTE=600

# --- Sources ----------------------------------------------------------------
# Feeds and pages are fetched from URLs users type in. Only public internet addresses are
# allowed unless this is true (for a feed on your own network, e.g. a self-hosted RSS bridge).
# Link-local/metadata addresses are always refused.
SOURCES_ALLOW_PRIVATE_NETWORKS=false

# --- Runs (the generation pipeline) -----------------------------------------
# A run that reports no progress for this long is failed by the reaper (needs the beat service).
RUN_TIMEOUT_MINUTES=60
RUN_STAGE_MAX_RETRIES=3
RUN_REAPER_INTERVAL_S=60

# --- Episode audio -------------------------------------------------------------
AUDIO_TARGET_LUFS=-16
AUDIO_BITRATE_KBPS=128
# 1 = mono (plenty for speech), 2 = stereo
AUDIO_CHANNELS=1
AUDIO_SEGMENT_GAP_MS=400
AUDIO_TRANSITION_GAP_MS=900
# Level of the music bed under the speech, before it is ducked further while people talk.
AUDIO_MUSIC_VOLUME_DB=-22

# --- Text-to-speech stage -----------------------------------------------------
TTS_CONCURRENCY=4
TTS_CHUNK_RETRIES=2
TTS_RETRY_BACKOFF_S=1

# --- Ingest (collecting stories before an episode) --------------------------
INGEST_FRESHNESS_DAYS=3
INGEST_DEDUP_DAYS=14
# Trigram similarity (0-1) at which two headlines count as the same story.
INGEST_TITLE_SIMILARITY=0.55
INGEST_SOURCE_TIMEOUT_S=30

# --- Source discovery (optional) -------------------------------------------
# The model that searches the web for sources. Empty: the show's model, then the default below.
# On OpenRouter ":online" is added to the model id so it can search. Provider is
# openrouter | openai | openai_compatible.
DISCOVERY_LLM_PROVIDER=
DISCOVERY_LLM_MODEL=

# --- Defaults for new shows (optional) ----------------------------------
# Applied when a show is created without its own choice. Provider is one of
# openrouter | openai | openai_compatible; style is news_briefing | conversational |
# deep_dive | interview. Leave the model empty to choose per show.
DEFAULT_LLM_PROVIDER=
DEFAULT_LLM_MODEL=
DEFAULT_SHOW_STYLE=news_briefing

# --- Media storage (covers, audio) ---------------------------------------
# local: files on the media volume (default). s3: any S3-compatible service (AWS S3, MinIO,
# RustFS, ...). With the bundled service (`make up-full`) use:
#   STORAGE_BACKEND=s3  S3_ENDPOINT_URL=http://s3:9000  S3_BUCKET=byop
#   and S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY of your choice (the service uses the same values).
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
# Only if links for browsers must use another address than S3_ENDPOINT_URL.
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Langfuse tracing (optional, see docs/langfuse.md) ------------------
# Leave the keys empty to switch tracing off. For Langfuse Cloud use the keys of your project and
# the host below; for the local `make up-full` stack use pk-lf-byop-local / sk-lf-byop-local,
# LANGFUSE_HOST=http://langfuse-web:3000 and LANGFUSE_PUBLIC_URL=http://localhost:3000.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Only if your browser reaches Langfuse at another address than BYOP's containers do. The
# "Open trace in Langfuse" links are built from it (default: LANGFUSE_HOST).
LANGFUSE_PUBLIC_URL=
